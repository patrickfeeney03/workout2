{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gym-tracker",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_als"],
	// The D1 primary lives in ENAM and has no South American alternative (D1 has no `sam` region,
	// Durable Objects do not spawn there either). Pin the Worker next to the database so the many
	// per-page D1 round trips become ~1ms instead of ~160ms; only the request forwarding is paid.
	"placement": {
		"mode": "targeted",
		"region": "aws:us-east-1"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gym-tracker",
			"database_id": "4597a552-baac-423d-acaf-a52d15b3cce7",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "gym-media"
		}
	],
	// Only names listed here are promoted from `.env`/`.dev.vars` into the Worker's
	// `env` in local dev; anything else in those files is ignored.
	"secrets": {
		"required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "ALLOWED_EMAILS"]
	},
	"dev": {
		"port": 8787
	}
}
