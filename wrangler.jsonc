{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gym-tracker",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_als"],
	// The D1 primary lives in WEUR (LHR). Measured from Lima: a D1 round trip costs ~230ms when the
	// Worker runs at the receiving edge (GIG) but ~15ms when it runs next to the primary, and each
	// request still makes at least one D1 round trip. Targeted placement removes that hop for reads
	// and writes alike. `request.cf.colo` keeps reporting the receiving edge, so verify placement
	// with a Worker->D1 round-trip measurement, not cf.colo. Re-evaluate if a read replica starts
	// serving the Americas (see docs/REGIONAL-PERFORMANCE.md).
	"placement": {
		"mode": "targeted",
		"region": "aws:eu-west-2"
	},
	// Placement is intentionally off. The Worker runs at its edge default, and D1 read replication
	// (plus the Sessions API in src/hooks.server.ts) serves reads from the replica nearest the user.
	// Smart Placement is a traffic-based optimization: it needs requests from several locations
	// before it moves anything, and pinning the Worker moves *all* requests — including the reads a
	// replica could have served locally — to one location. Re-evaluate only after measuring median
	// and tail latency from Ireland and Peru (docs/REGIONAL-PERFORMANCE.md).
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Western Europe primary (weur), created 2026-09-20, with read replication. The previous
			// ENAM primary was 4597a552-baac-423d-acaf-a52d15b3cce7; it is retained for rollback
			// (docs/REGIONAL-PERFORMANCE.md). Changing this database again means bumping
			// D1_BOOKMARK_COOKIE in src/lib/server/d1.ts so stale bookmarks are ignored.
			"database_name": "gym-tracker-weur",
			"database_id": "8a2604e1-a45b-4c94-a61c-c635c19e4035",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "gym-media"
		}
	],
	// Only names listed here are promoted from `.env`/`.dev.vars` into the Worker's
	// `env` in local dev; anything else in those files is ignored.
	"secrets": {
		"required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GOOGLE_REDIRECT_URI", "ALLOWED_EMAILS"]
	},
	"dev": {
		"port": 8787
	}
}
