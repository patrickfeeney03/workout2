{
	"name": "gym-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"types": "wrangler types && node scripts/clean-types.mjs",
		"db:migrate:local": "wrangler d1 migrations apply gym-tracker --local",
		"db:migrate:remote": "wrangler d1 migrations apply gym-tracker --remote",
		"db:list:local": "wrangler d1 migrations list gym-tracker --local",
		"db:list:remote": "wrangler d1 migrations list gym-tracker --remote",
		"secrets": "wrangler secret list",
		"deploy": "npm run build && wrangler deploy",
		"deploy:dry": "npm run build && wrangler deploy --dry-run",
		"tail": "wrangler tail"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260919.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.135.0"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"lucide-svelte": "^1.0.1",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260815.1": true,
		"workerd@1.20260918.1": true,
		"sharp@0.35.2": true,
		"sharp@0.35.4": true
	}
}
